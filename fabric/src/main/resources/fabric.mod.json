{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Critters and Companions is a vanilla-style creature mod which fills the overworld with new animals.",
  "authors": [
    "${mod_author}"
  ],
  "icon": "logo.png",
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.eterdelta.crittersandcompanions.CrittersAndCompanionsFabric"
    ],
    "client": [
      "com.github.eterdelta.crittersandcompanions.CrittersAndCompanionsFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/world/entity/Mob": [
        "com/github/eterdelta/crittersandcompanions/entity/brain/behaviour/BehaviourDriven"
      ]
    }
  },
  "depends": {
    "fabricloader": ">=0.15",
    "fabric-api": "*",
    "minecraft": "1.21.x",
    "java": ">=21",
    "geckolib": "*"
  }
}
